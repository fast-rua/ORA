{
 "schema": "ora.context-scheme.v2",
 "id": "context_age_scripts",
 "description": "Retired 2026-11-05 from ora/policy/context_schemes; kept as a test fixture of the stages and management versions that remain. context_keep_written plus script aging: in an aged exchange a tool call's arguments over 1,024 bytes become a reference with their first and last 128 bytes, as under context_rolling_tail_v3, and the rewritten message keeps its reasoning bound to the rewrite when the Provider's reasoning is unsigned (reasoning_binding rebind_unsigned; signed reasoning is withheld), so it measures script aging without dropping reasoning. Otherwise context_keep_written. A comparison arm, not a default.",
 "policy": {
  "context_profile": "native_causal_context_v1",
  "context_composition": "native_slots_v4",
  "context_retention": "action_step_lossless_v4",
  "summary_policy": "rollout_checkpoint_v1",
  "memory_policy": "disabled",
  "provider_continuation_replay": "exact_v1",
  "initial_observation": "automatic",
  "context_tools": [
   "artifact_read"
  ]
 },
 "segments": {
  "unit": "exchange",
  "exact_tail": 6,
  "exact_tail_unit": "exchange"
 },
 "limits": {
  "reserve_tokens": 2048
 },
 "estimator": {
  "image_tokens": 530
 },
 "references": {
  "pointers": true,
  "advertise_over_bytes": null,
  "preview": {
   "head_bytes": 0
  }
 },
 "stages": [
  {
   "stage": "materialize",
   "params": {}
  },
  {
   "stage": "exchange_aging",
   "params": {
    "trigger_tokens": 100000,
    "trigger_ratio": 0.5,
    "exact_tail_exchanges": 6,
    "argument_bytes": 1024,
    "result_bytes": 8192,
    "preview": {
     "head_bytes": 128,
     "tail_bytes": 128
    },
    "result_preview": "structured",
    "keep_anchor": true
   }
  },
  {
   "stage": "reasoning_replay",
   "params": {
    "mode": "all",
    "binding": "rebind_unsigned"
   }
  },
  {
   "stage": "camera_delivery",
   "params": {
    "mode": "exchange_window_v1",
    "tail_observations": null
   }
  },
  {
   "stage": "episode_capsule",
   "params": {
    "trigger_tokens": null,
    "trigger_ratio": 0.15,
    "checkpoint_target_tokens": 1200,
    "checkpoint_max_tokens": 1600
   }
  },
  {
   "stage": "emergency_checkpoint",
   "params": {
    "trigger_tokens": null,
    "trigger_ratio": 0.6,
    "target_ratio": 0.5,
    "unit": "exchange",
    "checkpoint_target_tokens": 1200,
    "checkpoint_max_tokens": 1600
   }
  },
  {
   "stage": "hard_backstop",
   "params": {
    "exact_tail_exchanges": 2
   }
  }
 ]
}
