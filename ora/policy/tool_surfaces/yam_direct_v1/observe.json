{
  "schema": "ora.toolkit-tool.v1",
  "name": "observe",
  "description": "Draw labelled overlays on the current camera images without moving anything.\nUse when: you want each TCP (L and R) or names already solved by mark_point drawn on the current images. Current RGB from every camera already arrives with each observation; use those images directly when they are enough. Omitted views selects every camera.\nEffect: read-only; it renders the latest observation and never recaptures or advances the world.\nReturns: the views drawn, their pixel dimensions, both arms' measured TCP pose with each gripper's command target, and one overlaid image per view.\nDoes not: identify objects, measure depth, establish contact, attachment or task success, or show anything newer than the latest observation.\nOn error: request only camera names from the views enum, each once; pass history_point_ids only for names mark_point has solved on the current observation.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "views": {
        "type": [
          "array",
          "null"
        ],
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "overhead",
            "front",
            "wrist_left",
            "wrist_right"
          ]
        },
        "description": "Cameras to draw; omit or pass null for every camera."
      },
      "history_point_ids": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "Names solved by mark_point on the current observation to overlay; omit or pass null for none."
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "success",
      "observation_id",
      "views",
      "end_effectors",
      "view_dimensions"
    ],
    "properties": {
      "success": {
        "type": "boolean",
        "const": true
      },
      "observation_id": {
        "type": "string"
      },
      "views": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "enum": [
            "overhead",
            "front",
            "wrist_left",
            "wrist_right"
          ]
        }
      },
      "end_effectors": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left",
          "right"
        ],
        "properties": {
          "left": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pose_xyz_xyzw",
              "gripper_command_target"
            ],
            "properties": {
              "pose_xyz_xyzw": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 7,
                "maxItems": 7
              },
              "gripper_command_target": {
                "type": "string",
                "enum": [
                  "open",
                  "close",
                  "unknown"
                ]
              }
            }
          },
          "right": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pose_xyz_xyzw",
              "gripper_command_target"
            ],
            "properties": {
              "pose_xyz_xyzw": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 7,
                "maxItems": 7
              },
              "gripper_command_target": {
                "type": "string",
                "enum": [
                  "open",
                  "close",
                  "unknown"
                ]
              }
            }
          }
        }
      },
      "view_dimensions": {
        "type": "object"
      }
    }
  }
}
