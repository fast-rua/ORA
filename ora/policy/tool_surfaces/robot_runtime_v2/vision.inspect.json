{
  "schema": "ora.toolkit-tool.v1",
  "name": "vision.inspect",
  "description": "Inspect one current or saved policy-visible camera image or deterministic crop. Overlays are visual annotations and do not create metric depth or hidden scene facts. Pixels use zero-based OpenCV (u,v) in the selected source image.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "camera": {
        "type": "string"
      },
      "modality": {
        "type": "string",
        "enum": [
          "rgb",
          "depth"
        ]
      },
      "crop": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "resolution": {
        "type": "string",
        "enum": [
          "thumbnail",
          "full"
        ]
      },
      "step": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      }
    },
    "required": [
      "camera"
    ],
    "additionalProperties": false
  },
  "resultSchema": null
}
