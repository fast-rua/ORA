                          "const": true
                        },
                        "ik_model": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "matches_move_pose_admission": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "claim_boundary": {
