{
  "schema": "ora.toolkit-tool.v1",
  "name": "rotate_pitch",
  "description": "Tilt the current approach axis while holding position.\nUse when: rotating the right grip site about its lateral axis (Panda local +Y) while holding position — for example tilting the approach direction between top-down and side grasps.\nEffect: compiles the signed angle to an exact pose through canonical move_pose; it executes as a precision move as move_pose describes. One robot decision. speed, speed_m_s and slow_approaching (optional) work as on move_pose.\nReturns: an immediate acknowledgement with status=submitted, action and compiled_pose; compiled_pose.targets contains the compiled requested target, not a measured arrival. The subsequent Supervisor receipt and fresh causal observation separately report execution route, phase outcomes and measured residuals. A pre-admission error submits no action.\nDoes not: translate, command the gripper, or prove the new approach direction clears obstacles — verify from a fresh observation.\nOn error: Refused: an angle outside [-180, 180] degrees or not a finite number; an angle of 0; a target outside the bound action workspace (workspace_bounds), which includes any rotation while the grip site is already outside it; the episode's terminal boundary (episode_terminal). Speed options are refused as on move_pose. Check the current grip-site axes and correct the sign or magnitude; use move_pose when position must change together with orientation. Numerical inputs follow compute's Use when rule; send every value in this tool's declared units and frame.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "angle_deg": {
        "description": "Signed rotation in degrees about the grip-site lateral axis (Panda local +Y), holding position.",
        "maximum": 180,
        "minimum": -180,
        "type": "number"
      },
      "speed": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "fast",
          "normal",
          "careful",
          null
        ],
        "description": "Optional; default fast. As move_pose's speed. Leave it out when you give speed_m_s. Null means omitted."
      },
      "speed_m_s": {
        "type": [
          "number",
          "null"
        ],
        "description": "Optional, instead of speed: as move_pose's speed_m_s. Null means omitted."
      },
      "slow_approaching": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Optional; default false. As move_pose's slow_approaching. Null means omitted."
      }
    },
    "required": [
      "angle_deg"
    ],
    "type": "object"
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "const": "submitted"
      },
      "action": {
        "type": "string",
        "const": "rotate_pitch"
      },
      "compiled_pose": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "observed_clearance": {
                  "type": "object",
                  "description": "Read-only, from the current depth images: the jaw footprint's lowest point at this target minus the highest observed surface beneath it or within radius_m; negative means that surface is higher. Not a collision check.",
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "clearance_m",
                        "highest_surface",
                        "footprint_lowest_m",
                        "footprint_lowest_part",
                        "radius_m",
                        "footprint_observed_fraction",
                        "robot_points_excluded",
                        "held_object",
                        "claim_boundary"
                      ],
                      "properties": {
                        "status": {
                          "const": "measured"
                        },
                        "clearance_m": {
                          "type": "number"
                        },
                        "highest_surface": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "position_m",
                            "camera",
                            "observation_id",
                            "depth_points"
                          ],
                          "properties": {
                            "position_m": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "minItems": 3,
                              "maxItems": 3
                            },
                            "camera": {
                              "type": "string"
                            },
                            "observation_id": {
                              "type": "string"
                            },
                            "depth_points": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        },
                        "footprint_lowest_m": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "footprint_lowest_part": {
                          "type": "string",
                          "enum": [
                            "fingers",
                            "held_object"
                          ]
                        },
                        "radius_m": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "footprint_observed_fraction": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "robot_points_excluded": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "held_object": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "additionalProperties": false,
                          "required": [
                            "target_ref",
                            "extent_included",
                            "recentered_under_jaws"
                          ],
                          "description": "null unless the jaws measure as holding: the target the policy named when they closed and whether its localized extent is part of the footprint.",
                          "properties": {
                            "target_ref": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "extent_included": {
                              "type": "boolean"
                            },
                            "recentered_under_jaws": {
                              "type": "boolean"
                            }
                          }
                        },
                        "claim_boundary": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "reason",
                        "footprint_lowest_m",
                        "footprint_lowest_part",
                        "radius_m",
                        "footprint_observed_fraction",
                        "robot_points_excluded",
                        "held_object",
                        "claim_boundary"
                      ],
                      "properties": {
                        "status": {
                          "const": "unknown"
                        },
                        "reason": {
                          "type": "string",
                          "enum": [
                            "depth_unavailable",
                            "footprint_unobserved"
                          ]
                        },
                        "footprint_lowest_m": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "footprint_lowest_part": {
                          "type": "string",
                          "enum": [
                            "fingers",
                            "held_object"
                          ]
                        },
                        "radius_m": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "footprint_observed_fraction": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "robot_points_excluded": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "held_object": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "additionalProperties": false,
                          "required": [
                            "target_ref",
                            "extent_included",
                            "recentered_under_jaws"
                          ],
                          "description": "null unless the jaws measure as holding: the target the policy named when they closed and whether its localized extent is part of the footprint.",
                          "properties": {
                            "target_ref": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "extent_included": {
                              "type": "boolean"
                            },
                            "recentered_under_jaws": {
                              "type": "boolean"
                            }
                          }
                        },
                        "claim_boundary": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "reason",
                        "radius_m",
                        "claim_boundary"
                      ],
                      "properties": {
                        "status": {
                          "const": "unknown"
                        },
                        "reason": {
                          "type": "string",
                          "enum": [
                            "geometry_unavailable",
                            "reference_failed"
                          ]
                        },
                        "radius_m": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "claim_boundary": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "target_axes_world": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "approach",
                    "jaw_line"
                  ],
                  "description": "World directions of the approach axis and jaw line of the submitted target orientation, computed from its compiled quaternion.",
                  "properties": {
                    "approach": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "jaw_line": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "status",
      "action",
      "compiled_pose"
    ],
    "additionalProperties": false
  }
}
