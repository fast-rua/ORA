{
  "schema": "ora.native-baseline.v1",
  "id": "native_full_explicit_motion_direct_v4",
  "context_scheme": "context_lossless_v6",
  "code_mode_context_scheme": "context_keep_written",
  "policy": {
    "timeout_s": 900,
    "max_model_calls_per_observation": 120,
    "action_codec": "motion_action_v3",
    "require_live_marker": true,
    "provider_recovery": "first_token_deadline_v1"
  },
  "required_service_capabilities": [
    "resident_sam3_point_segmentation_v1",
    "resident_sam3_text_grounding_v1",
    "resident_contact_graspnet_v1"
  ],
  "instances": {
    "libero_pro": {
      "id": "libero_panda",
      "tool_surface": "libero_placement_direct_overhead_v1",
      "prompt_bundle": "ora/policy/prompt_bundles/current_v4/libero-panda-native_api-v4.yaml",
      "environment_prompt_profile": "libero_pro_public_direct_v1",
      "runtime": {
        "kind": "libero_pro",
        "transport": "local_rpc",
        "python_env": "LIBERO_PRO_PYTHON",
        "libero_pro_root_env": "LIBERO_PRO_ROOT",
        "data_root_env": "LIBERO_PRO_DATA_ROOT",
        "required_libero_pro_revision": "2b910b5b5f53016bef9907632f6f840f1ce2229c",
        "required_data_revision": "c86fc3b8293185a6f373677018ff3e37f8391602",
        "require_gpu": true,
        "main_camera": "agentview",
        "policy_cameras": [
          "agentview",
          "wrist"
        ],
        "controlled_end_effector": "right",
        "startup_timeout_s": 600,
        "request_timeout_s": 1800,
        "servo_max_steps": 80,
        "workspace_profile": "libero_pro_panda_hybrid_motion_v1",
        "motion_planner": {
          "implementation": "curobo_v2",
          "python_env": "CUROBO_V2_PYTHON",
          "root_env": "CUROBO_V2_ROOT",
          "required_revision": "d17b54ce32cba095c0b000c4c58777075d11de0e",
          "request_timeout_s": 180,
          "world_model": "public_depth_voxel_v1",
          "timing": {
            "implementation": "toppra_ruckig",
            "python_env": "ORA_TIMING_PYTHON"
          }
        },
        "motion_profile": "ora/policy/embodiments/franka-panda/motion-profile-v4.json",
        "environment_driver": "direct_libero_v1"
      }
    },
    "robotwin": {
      "id": "robotwin_aloha",
      "tool_surface": "robotwin_toolchain_b2_closed_noservo_v2",
      "prompt_bundle": "ora/policy/prompt_bundles/current_v4/robotwin-aloha-native_api-v4.yaml",
      "environment_prompt_profile": "robotwin_public_explicit_v6",
      "runtime": {
        "kind": "robotwin",
        "transport": "local_rpc",
        "python_env": "ROBOTWIN_PYTHON",
        "root_env": "ROBOTWIN_ROOT",
        "required_revision": "cf4872cc90538fd4bca761c8db912d8f65e49f2b",
        "require_gpu": true,
        "main_camera": "head_camera",
        "policy_cameras": [
          "head_camera",
          "front_camera",
          "left_camera",
          "right_camera"
        ],
        "policy_observer_camera": false,
        "environment_signal_policy": "lifecycle_only",
        "startup_timeout_s": 600,
        "request_timeout_s": 1800,
        "task_config": "demo_randomized",
        "workspace_bounds_m": {
          "x": [
            -0.6,
            0.6
          ],
          "y": [
            -0.4,
            0.4
          ],
          "z": [
            0.7,
            1.45
          ]
        },
        "control_profile": "ora/policy/embodiments/aloha-agilex/control-profile-v10.json",
        "motion_planner": {
          "implementation": "curobo_v2",
          "python_env": "CUROBO_V2_PYTHON",
          "root_env": "CUROBO_V2_ROOT",
          "required_revision": "d17b54ce32cba095c0b000c4c58777075d11de0e",
          "request_timeout_s": 180,
          "robot": "aloha_agilex",
          "world_model": "public_depth_voxel_v1"
        },
        "motion_timing": {
          "implementation": "toppra_ruckig",
          "python_env": "ORA_TIMING_PYTHON"
        }
      }
    },
    "robocasa": {
      "id": "robocasa_panda_omron",
      "tool_surface": "robocasa_mobile_direct_v1",
      "prompt_bundle": "ora/policy/prompt_bundles/current_v4/robocasa-pandaomron-native_api-v4.yaml",
      "environment_prompt_profile": "robocasa_public_direct_v1",
      "runtime": {
        "kind": "robocasa",
        "transport": "local_rpc",
        "python_env": "ROBOCASA_PYTHON",
        "split": "target",
        "required_revisions": {
          "robocasa": "a9e152e2eea16d342dac40e4577fb4c68b932854",
          "robosuite": "5ce6643f3092639d08f7b0f90ed1c6a84f50552c"
        },
        "require_gpu": false,
        "main_camera": "agentview",
        "policy_cameras": [
          "agentview",
          "wrist"
        ],
        "controlled_end_effector": "right",
        "workspace_profile": "robocasa_pandaomron_kitchen_v1",
        "startup_timeout_s": 300,
        "request_timeout_s": 900,
        "close_timeout_s": 60,
        "motion_planner": {
          "implementation": "curobo_v2",
          "python_env": "CUROBO_V2_PYTHON",
          "root_env": "CUROBO_V2_ROOT",
          "required_revision": "d17b54ce32cba095c0b000c4c58777075d11de0e",
          "request_timeout_s": 180,
          "robot": "franka_panda",
          "world_model": "public_depth_voxel_v1"
        },
        "motion_timing": {
          "implementation": "toppra_ruckig",
          "python_env": "ORA_TIMING_PYTHON"
        }
      }
    },
    "robolab": {
      "id": "robolab_droid_franka_robotiq",
      "tool_surface": "robolab_direct_v1",
      "prompt_bundle": "ora/policy/prompt_bundles/current_v4/robolab-droid-native_api-v4.yaml",
      "environment_prompt_profile": "robolab_public_direct_v1",
      "runtime": {
        "kind": "robolab",
        "transport": "local_rpc",
        "root_env": "ROBOLAB_ROOT",
        "python_env": "ROBOLAB_PYTHON",
        "graphics_runtime_env": "ROBOLAB_GRAPHICS_RUNTIME",
        "required_revision": "ad45d4f974725d020f82c2b0d77d78533aeba2b3",
        "require_gpu": true,
        "main_camera": "agentview",
        "policy_cameras": [
          "agentview",
          "wrist"
        ],
        "controlled_end_effector": "right",
        "workspace_profile": "robolab_droid_tabletop_v1",
        "motion_planner": {
          "implementation": "curobo_v2",
          "python_env": "CUROBO_V2_PYTHON",
          "root_env": "CUROBO_V2_ROOT",
          "required_revision": "d17b54ce32cba095c0b000c4c58777075d11de0e",
          "request_timeout_s": 300,
          "robot": "franka_robotiq",
          "world_model": "public_depth_voxel_v1"
        },
        "motion_timing": {
          "implementation": "toppra_ruckig",
          "python_env": "ORA_TIMING_PYTHON"
        },
        "startup_timeout_s": 900,
        "request_timeout_s": 1200,
        "close_timeout_s": 120
      }
    }
  }
}
