#!/usr/bin/env sh
# Run this on the local machine: SSH terminal plus a local world-view browser.
# It needs only the standard library, so python3 from PATH serves too.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/scripts/lib/python.sh"
ora_python --stdlib ora-remote
exec "$PYTHON" -m ora.app.remote "$@"
